{
  "name": "picspeak-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "test": "node scripts/run-node-tests.mjs",
    "test:production-blog": "node --test --test-concurrency=1 test/blog-routing.production.test.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  }
}
