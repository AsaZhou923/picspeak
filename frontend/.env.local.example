# Copy to .env.local and fill in your values

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: homepage demo image. Defaults to a bundled local public asset.
NEXT_PUBLIC_DEMO_IMAGE_URL=

# Optional: extra HTTPS hosts the Next.js image optimizer may fetch from, as a
# comma-separated list of hostnames (a leading "*." or "**." label is allowed).
# The site, the API origin, Clerk avatars and Cloudflare R2 signed URLs are
# already allowed; set this only if images are served from somewhere else.
IMAGE_REMOTE_HOSTS=

# Optional: IndexNow verification key, 8-128 chars using a-z, A-Z, 0-9, or -
# Exposed at /indexnow-key.txt and used as keyLocation when submitting updated URLs.
INDEXNOW_KEY=
